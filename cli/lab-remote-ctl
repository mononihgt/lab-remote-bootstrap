@cli.command()
@click.option('--json', 'output_json', is_flag=True, help='Output in JSON format')
@click.pass_context
def health(ctx, output_json):
    """Run health check."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        print_info("Health check requires a valid configuration")
        sys.exit(1)

    from health import HealthCheck

    try:
        checker = HealthCheck(config)
        results = checker.run_all(check_connectivity=True)

        if output_json:
            click.echo(checker.format_json(results))
        else:
            click.echo(checker.format_terminal(results))

        # Exit with error code if checks failed
        if results['summary']['failed'] > 0:
            sys.exit(1)

    except Exception as e:
        print_error(f"Health check failed: {e}")
        sys.exit(1)


@cli.group()
def web():
    """Manage web interface."""
    pass


@web.command('start')
@click.pass_context
def web_start(ctx):
    """Start web service."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        sys.exit(1)

    returncode, _, stderr = run_target_service_command(
        config, "sudo systemctl start lab-web.service"
    )

    if returncode == 0:
        print_success("Web service started")
        access = resolve_web_access(config)
        if access.tunnel_command:
            if not ensure_web_tunnel(access):
                sys.exit(1)
            print_info(f"Local tunnel active: {access.url}")
        else:
            print_info(f"Access at: {access.url}")
    else:
        print_error(f"Failed to start web service: {stderr}")
        sys.exit(1)


@web.command('stop')
@click.pass_context
def web_stop(ctx):
    """Stop web service."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        sys.exit(1)

    returncode, _, stderr = run_target_service_command(
        config, "sudo systemctl stop lab-web.service"
    )

    if returncode == 0:
        access = resolve_web_access(config)
        if not stop_web_tunnel(access):
            sys.exit(1)
        print_success("Web service stopped")
    else:
        print_error(f"Failed to stop web service: {stderr}")
        sys.exit(1)


@web.command('open')
@click.pass_context
def web_open(ctx):
    """Open web interface."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        sys.exit(1)

    access = resolve_web_access(config)

    if access.tunnel_command:
        if not ensure_web_tunnel(access):
            sys.exit(1)

    print_info(f"Opening web interface: {access.url}")

    import webbrowser
    webbrowser.open(access.url)

