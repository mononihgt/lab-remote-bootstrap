@dataclass
class WebAccess:
    url: str
    tunnel_command: Optional[str] = None
    tunnel_args: Optional[List[str]] = None
    local_web_port: Optional[int] = None


def resolve_web_access(config) -> WebAccess:
    """Resolve how the operator should access the Web UI."""
    web_port = config.get('web.port', 5000)
    context = DeploymentContext.from_config(config)

    if context.target.is_local:
        return WebAccess(url=f"http://localhost:{web_port}")

    local_web_port = config.get('web.local_port', 5001)
    clash_api_port = config.get('clash.api_port', 9090)
    display_args = context.target_ssh_args(
        "-N",
        "-L",
        f"{local_web_port}:127.0.0.1:{web_port}",
        "-L",
        f"{clash_api_port}:127.0.0.1:{clash_api_port}",
    )
    tunnel_args = context.target_ssh_args(
        "-fN",
        "-o",
        "ExitOnForwardFailure=yes",
        "-L",
        f"{local_web_port}:127.0.0.1:{web_port}",
        "-L",
        f"{clash_api_port}:127.0.0.1:{clash_api_port}",
    )

    return WebAccess(
        url=f"http://localhost:{local_web_port}",
        tunnel_command=tunnel_args_to_display(display_args),
        tunnel_args=tunnel_args,
        local_web_port=local_web_port,
    )


def tunnel_args_to_display(args: List[str]) -> str:
    """Render tunnel args as a shell-friendly display string."""
    return " ".join(args)


def is_local_port_listening(port: int) -> bool:
    """Return True when localhost accepts TCP connections on port."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(0.2)
        return sock.connect_ex(("127.0.0.1", port)) == 0


def ensure_web_tunnel(access: WebAccess) -> bool:
    """Start the local SSH tunnel for remote Web access when needed."""
    if not access.tunnel_args or not access.local_web_port:
        return True

    if is_local_port_listening(access.local_web_port):
        return True

    result = subprocess.run(
        access.tunnel_args,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        details = (result.stderr or result.stdout or "").strip()
        print_error("Failed to start local Web tunnel")
        if details:
            print_info(details)
        return False

    return True


def stop_web_tunnel(access: WebAccess) -> bool:
    """Stop the local SSH tunnel used for remote Web access."""
    if not access.tunnel_args or not access.local_web_port:
        return True

    command = (
        f"pids=$(lsof -tiTCP:{access.local_web_port} -sTCP:LISTEN 2>/dev/null); "
        'if [ -n "$pids" ]; then kill $pids; fi'
    )
    result = subprocess.run(
        ["sh", "-c", command],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        details = (result.stderr or result.stdout or "").strip()
        print_error("Failed to stop local Web tunnel")
        if details:
            print_info(details)
        return False

    return True


def build_config_content(
    mode: str,
    deployment_target: str,
    target_host: str,
    target_user: str,
    target_ssh_port: int,
    target_ssh_identity_file: str,
    cloud_host: str,
    cloud_user: str,
    reverse_port: int,
    clash_http: int,
    clash_socks: int,
    clash_api: int,
    autossh_identity_file: str,
) -> str:
    """Build config.yaml content."""
    target_section = ""
    if deployment_target == "remote":
        target_section = f"""
target:
  host: {target_host}
  user: {target_user}
  ssh_port: {target_ssh_port}
  ssh_identity_file: {target_ssh_identity_file}
"""

    return f"""# Lab Remote Bootstrap Configuration
# Generated by interactive wizard

deployment:
  mode: {mode}
  target: {deployment_target}
{target_section}
cloud:
  host: {cloud_host}
  user: {cloud_user}
  reverse_port: {reverse_port}
  reverse_bind_address: 0.0.0.0

clash:
  install_root: /opt/lab-remote-stack
  http_port: {clash_http}
  socks_port: {clash_socks}
  api_port: {clash_api}
  api_secret: ""

  subscription:
    template: balanced
    auto_update: false
    update_interval: 86400

autossh:
  identity_file: {autossh_identity_file}

zsh:
  enable_plugins: true
  custom_config:
    autosuggestions_style: "fg=240"
    fzf_theme:
      fg: "#CBE0F0"
      bg: "#011628"
      bg_highlight: "#143652"
      purple: "#B388FF"
      blue: "#06BCE4"
      cyan: "#2CF9ED"
    bat_theme: "tokyonight_night"
    eza_aliases: true
    tldr_alias: true
    fastfetch_on_startup: true

web:
  enabled: true
  port: 5000
  local_port: 5001
  bind: 127.0.0.1
"""


def build_subscriptions_content() -> str:
    """Build an empty subscriptions.json seed file."""
    data = {
        "version": "1.0",
        "active": None,
        "subscriptions": [],
    }
    return json.dumps(data, indent=2, ensure_ascii=False)


def subscription_scope_option(func):
    """Add the subscription storage scope option to a command."""
    return click.option(
        '--scope',
        type=click.Choice(['live', 'workspace']),
        default='live',
        show_default=True,
        help='Subscription storage scope: live target config or workspace files',
    )(func)


def restart_clash_service(config) -> bool:
    """Restart Clash on the live deployment target."""
    returncode, _, stderr = DeploymentContext.from_config(config).run(
        "sudo systemctl restart lab-clash.service"
    )

    if returncode != 0:
        print_error(f"Failed to restart Clash service: {stderr}")
        return False

    print_success("Clash service restarted")
    return True


def run_target_service_command(config, command: str):
    """Run a systemd command on the configured deployment target."""
    return DeploymentContext.from_config(config).run(command)


@click.group()
@click.option('-c', '--config', 'config_path', help='Path to config file')
@click.option('-v', '--verbose', is_flag=True, help='Verbose output')
@click.pass_context
def cli(ctx, config_path, verbose):
    """Lab Remote Bootstrap - Manage remote development environments."""
    supported, details = check_python_version()
    if not supported:
        raise click.ClickException(details)
    ctx.ensure_object(dict)
    ctx.obj['verbose'] = verbose
    ctx.obj['config_path'] = config_path


@cli.command()
@click.option('--mode', type=click.Choice(['host', 'docker']), help='Deployment mode')
@click.option('--interactive', is_flag=True, help='Interactive configuration')
@click.pass_context
def init(ctx, mode, interactive):
    """Initialize configuration file."""
    from pathlib import Path
    import shutil

    project_root = Path(__file__).parent.parent
    example_config = project_root / "config" / "config.example.yaml"
    target_config = project_root / "config" / "config.yaml"

    if target_config.exists():
        if not click.confirm(f"Config file already exists at {target_config}. Overwrite?"):
            print_info("Keeping existing configuration")
            return

    if interactive:
        print_info("Interactive configuration wizard")
        click.echo("\nPlease provide the following information:")

        # Deployment target
        deployment_target = click.prompt(
            "Deployment target",
            type=click.Choice(['local', 'remote']),
            default='remote',
            show_choices=True
        )

        if deployment_target == 'local':
            print_info("\n📍 Local deployment mode:")
            print_info("  - Deploying directly on this machine")
            print_info("  - No SSH connection needed")
            print_info("  - Use this for first-time setup on lab server")
            target_host = ""
            target_user = ""
            target_ssh_port = 22
            target_ssh_identity_file = ""
        else:
            print_info("\nTarget lab server access:")
            print_info("  - Used by this CLI to install services on the lab server")
            target_host = click.prompt("Target lab server SSH host", type=str)
            target_user = click.prompt("Target lab server SSH user", type=str)
            target_ssh_port = click.prompt("Target lab server SSH port", type=int, default=22)
            target_ssh_identity_file = click.prompt(
                "Local SSH identity file for target access (empty to use SSH config/agent)",
                type=str,
                default="",
                show_default=False,
            )

        # Cloud server
        print_info("\nCloud server for AutoSSH reverse tunnel:")
        print_info("  - Used by the lab server to publish the reverse SSH tunnel")
        cloud_host = click.prompt("Cloud server public host", type=str)
        cloud_user = click.prompt("Cloud server SSH user for AutoSSH tunnel", type=str, default="ubuntu")
        reverse_port = click.prompt("Cloud reverse tunnel port", type=int, default=2223)

        # Deployment mode
        if not mode:
            mode = click.prompt(
                "Deployment mode",
                type=click.Choice(['host', 'docker']),
                default='host'
            )

        # Clash ports
        clash_http = click.prompt("Clash HTTP proxy port", type=int, default=7890)
        clash_socks = click.prompt("Clash SOCKS proxy port", type=int, default=7891)
        clash_api = click.prompt("Clash API port", type=int, default=9090)

        # AutoSSH
        ssh_key = click.prompt(
            "Server-side SSH identity file for AutoSSH",
            type=str,
            default="~/.ssh/id_ed25519_autossh"
        )

        # Generate config
        config_content = build_config_content(
            mode=mode,
            deployment_target=deployment_target,
            target_host=target_host,
            target_user=target_user,
            target_ssh_port=target_ssh_port,
            target_ssh_identity_file=target_ssh_identity_file,
            cloud_host=cloud_host,
            cloud_user=cloud_user,
            reverse_port=reverse_port,
            clash_http=clash_http,
            clash_socks=clash_socks,
            clash_api=clash_api,
            autossh_identity_file=ssh_key,
        )

        if mode == 'docker':
            container_name = click.prompt("Docker container name", default="lab-remote-dev")
            root_password = click.prompt("Container root password", hide_input=True)
            config_content += f"""
docker:
  container_name: {container_name}
  root_password: {root_password}
  host_ssh_port: 2222
  target_user: developer
"""

        target_config.parent.mkdir(parents=True, exist_ok=True)
        target_config.write_text(config_content)
        print_success(f"Configuration saved to {target_config}")

        subscriptions_file = project_root / "config" / "subscriptions.json"
        subscriptions_file.write_text(build_subscriptions_content())
        print_success(f"Empty subscription state saved to {subscriptions_file}")

    else:
        # Non-interactive: copy example
        if not example_config.exists():
            print_error(f"Example config not found: {example_config}")
            sys.exit(1)

        target_config.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(example_config, target_config)
        print_success(f"Configuration template created at {target_config}")
        print_info("Please edit the file to customize your setup")

    print_info(f"\nNext steps:")
    print_info(f"  1. Edit {target_config} to customize your setup")
    command = "uv run --python 3.12 --with-requirements requirements.txt ./cli/lab-remote-ctl"
    print_info(f"  2. Add a subscription with '{command} subscription add <name> <url> --scope workspace'")
    print_info(f"  3. Run '{command} subscription update <name> --scope workspace' to generate Clash config")
    print_info(f"  4. Run '{command} deploy' to deploy")


@cli.command()
@click.option('--dry-run', is_flag=True, help='Show what would be done without doing it')
@click.option('--skip-clash', is_flag=True, help='Skip Clash deployment')
@click.option('--skip-autossh', is_flag=True, help='Skip AutoSSH deployment')
@click.option('--skip-zsh', is_flag=True, help='Skip Zsh configuration')
@click.option('--skip-web', is_flag=True, help='Skip Web interface deployment')
@click.pass_context
def deploy(ctx, dry_run, skip_clash, skip_autossh, skip_zsh, skip_web):
    """Deploy to remote server."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        print_info("Run 'uv run --python 3.12 --with-requirements requirements.txt ./cli/lab-remote-ctl init' to create a configuration file")
        sys.exit(1)

    from deployer import deploy as run_deploy

    verbose = ctx.obj.get('verbose', False)

    try:
        success = run_deploy(
            config,
            skip_clash=skip_clash,
            skip_autossh=skip_autossh,
            skip_zsh=skip_zsh,
            skip_web=skip_web,
            dry_run=dry_run,
            verbose=verbose
        )

        if not success:
            sys.exit(1)

    except KeyboardInterrupt:
        print_error("\nDeployment interrupted")
        sys.exit(1)
    except Exception as e:
        print_error(f"Deployment failed: {e}")
        if verbose:
            import traceback
            traceback.print_exc()
        sys.exit(1)


