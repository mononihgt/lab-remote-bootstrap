@cli.command()
@click.option('--json', 'output_json', is_flag=True, help='Output in JSON format')
@click.pass_context
def health(ctx, output_json):
    """Run health check."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        print_info("Health check requires a valid configuration")
        sys.exit(1)

    from health import HealthCheck

    try:
        checker = HealthCheck(config)
        results = checker.run_all(check_connectivity=True)

        if output_json:
            click.echo(checker.format_json(results))
        else:
            click.echo(checker.format_terminal(results))

        # Exit with error code if checks failed
        if results['summary']['failed'] > 0:
            sys.exit(1)

    except Exception as e:
        print_error(f"Health check failed: {e}")
        sys.exit(1)


