@subscription.command('add')
@click.argument('name')
@click.argument('url')
@click.option('--template', default='balanced', help='Conversion template')
@subscription_scope_option
@click.pass_context
def subscription_add(ctx, name, url, template, scope):
    """Add a new subscription."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        sys.exit(1)

    from subscription import Subscription
    from subscription_store import SubscriptionStore

    store = SubscriptionStore(config, scope=scope)
    try:
        store.prepare()
        sub_manager = Subscription(str(store.local_paths.subscriptions_file))
        sub_manager.add(name, url, template)
        store.sync(upload_config=False)
        print_success(f"Added subscription: {name}")
        print_info(f"  URL: {url}")
        print_info(f"  Template: {template}")
        scope_arg = "" if scope == "live" else " --scope workspace"
        print_info(
            f"\nRun 'uv run --python 3.12 --with-requirements requirements.txt ./cli/lab-remote-ctl subscription update {name}{scope_arg}' "
            "to download and activate"
        )
    except Exception as e:
        print_error(f"Failed to add subscription: {e}")
        sys.exit(1)
    finally:
        store.cleanup()


@subscription.command('list')
@subscription_scope_option
@click.pass_context
def subscription_list(ctx, scope):
    """List all subscriptions."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        sys.exit(1)

    from subscription import Subscription
    from subscription_store import SubscriptionStore

    store = SubscriptionStore(config, scope=scope)
    try:
        store.prepare()
        sub_manager = Subscription(str(store.local_paths.subscriptions_file))
        subs = sub_manager.list()

        if not subs:
            print_info("No subscriptions found")
            print_info("Add one with: uv run --python 3.12 --with-requirements requirements.txt ./cli/lab-remote-ctl subscription add <name> <url>")
            return

        active = sub_manager.data.get('active')
        click.echo(f"\n📡 Subscriptions ({scope}):\n")

        for sub in subs:
            status_marker = "✓" if sub['name'] == active else "○"
            status_text = "[Active]" if sub['name'] == active else ""

            click.echo(f"  {status_marker} {sub['name']} {status_text}")
            click.echo(f"     URL: {sub['url']}")
            if sub['last_update']:
                click.echo(f"     Updated: {sub['last_update']}")
                click.echo(f"     Nodes: {sub['node_count']}")
            else:
                click.echo(f"     Status: Not yet updated")
            click.echo()

    except Exception as e:
        print_error(f"Failed to list subscriptions: {e}")
        sys.exit(1)
    finally:
        store.cleanup()


