@subscription.command('update')
@click.argument('name')
@subscription_scope_option
@click.pass_context
def subscription_update(ctx, name, scope):
    """Update a subscription."""
    try:
        config = load_config(ctx.obj.get('config_path'))
    except ConfigError as e:
        print_error(f"Configuration error: {e}")
        sys.exit(1)

    from subscription import Subscription
    from utils import get_project_root
    from subscription_store import SubscriptionStore

    store = SubscriptionStore(config, scope=scope)

    project_root = get_project_root()
    template_dir = str(project_root / "assets" / "clash" / "templates")

    try:
        store.prepare()
        sub_manager = Subscription(str(store.local_paths.subscriptions_file))
        print_info(f"Updating subscription: {name}")

        sub_type, node_count = sub_manager.update(name, template_dir, str(store.local_paths.config_file))
        store.sync(upload_config=True)

        print_success(f"Subscription updated: {name}")
        print_info(f"  Type: {sub_type}")
        print_info(f"  Nodes: {node_count}")
        print_info(f"  Config: {store.remote_paths.config_file if scope == 'live' else store.local_paths.config_file}")
        if scope == "live":
            if not restart_clash_service(config):
                sys.exit(1)
        else:
            print_info(
                "\nRun 'uv run --python 3.12 --with-requirements requirements.txt ./cli/lab-remote-ctl deploy --skip-autossh --skip-zsh --skip-web' "
                "to publish workspace changes"
            )

    except Exception as e:
        print_error(f"Failed to update subscription: {e}")
        sys.exit(1)
    finally:
        store.cleanup()


